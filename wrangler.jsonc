{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "four",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-28",

  // Static client. single-page-application makes any unmatched path
  // (notably /g/<code>) serve index.html; run_worker_first hands the
  // WebSocket endpoint to the Worker before assets can swallow it.
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/g/*/ws"],
    "binding": "ASSETS"
  },

  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "GameDO" }]
  },

  // SQLite-backed class: required on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameDO"] }]
}
